# Environment configuration for RADAR PUB
# Copy this file to .env and fill in the values.

# Database
DATABASE_URL=sqlite:///radar-pub.db

# Logging
LOG_LEVEL=info

# Hermes Integration
HERMES_RPC_URL=http://localhost:8080
HERMES_RPC_TOKEN=

# PDL Integration (futuro)
PDL_API_URL=
PDL_API_TOKEN=

# Cloudflare Pages (frontend)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Redis (futuro)
REDIS_URL=redis://localhost:6379

# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=